{
  "id": "c13-thread-declared-before-data",
  "outcome": "violation",
  "rules": [
    "C.13"
  ],
  "context": {
    "std": "c++20",
    "exceptions": true,
    "requires": [
      "std::jthread (libstdc++ 10+, libc++ 18+)"
    ]
  },
  "expect": {
    "must_cite_any": [
      "C.13"
    ],
    "fix": {
      "must_compile": true,
      "properties": [
        "value_ declared before worker_",
        "no other behaviour change"
      ]
    }
  },
  "notes": "Members initialize in declaration order (initializer-list order is irrelevant); -Wreorder may also fire.",
  "source": "held-out (written for this suite, not copied from the Guidelines' examples)"
}
