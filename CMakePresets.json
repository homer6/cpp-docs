{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "gcc-15",
      "displayName": "GCC 15 (Homebrew g++-15, libstdc++)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++-15"
      }
    },
    {
      "name": "clang-22",
      "displayName": "Clang 22 (Homebrew LLVM, libc++)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm/bin/clang++",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++",
        "CMAKE_CXX_STDLIB_MODULES_JSON": "/opt/homebrew/opt/llvm/lib/c++/libc++.modules.json",
        "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++ -L/opt/homebrew/opt/llvm/lib/c++ -L/opt/homebrew/opt/llvm/lib/unwind -lunwind -Wl,-rpath,/opt/homebrew/opt/llvm/lib/c++ -Wl,-rpath,/opt/homebrew/opt/llvm/lib/unwind"
      }
    },
    {
      "name": "gcc-16",
      "displayName": "GCC 16 (run inside the gcc:16 Docker image; see README)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "generic",
      "hidden": true,
      "inherits": "base",
      "description": "Portable presets for CI and other machines: no compiler paths, the compiler comes from CXX or -DCMAKE_CXX_COMPILER."
    },
    {
      "name": "gcc",
      "displayName": "GCC + libstdc++ (compiler from CXX, default g++)",
      "inherits": "generic",
      "cacheVariables": {
        "CPPDOCS_TOOLCHAIN": "gcc"
      }
    },
    {
      "name": "clang",
      "displayName": "Clang + the platform's default library (libstdc++ on Linux; compiler from CXX, default clang++)",
      "inherits": "generic",
      "cacheVariables": {
        "CPPDOCS_TOOLCHAIN": "clang"
      }
    },
    {
      "name": "clang-libcxx",
      "displayName": "Clang + libc++ (compiler from CXX, default clang++)",
      "inherits": "generic",
      "cacheVariables": {
        "CPPDOCS_TOOLCHAIN": "clang-libcxx",
        "CMAKE_CXX_FLAGS_INIT": "-stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS_INIT": "-stdlib=libc++"
      }
    },
    {
      "name": "msvc",
      "displayName": "MSVC cl + MS STL (run from a VS Developer shell; compiler from CXX, default cl)",
      "inherits": "generic",
      "cacheVariables": {
        "CPPDOCS_TOOLCHAIN": "msvc"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "clang-cl",
      "displayName": "clang-cl + MS STL (run from a VS Developer shell; compiler from CXX, default clang-cl)",
      "inherits": "generic",
      "cacheVariables": {
        "CPPDOCS_TOOLCHAIN": "clang-cl"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "mingw",
      "displayName": "MinGW-w64 GCC + libstdc++ (MSYS2 or a cross g++; compiler from CXX, default g++)",
      "inherits": "generic",
      "cacheVariables": {
        "CPPDOCS_TOOLCHAIN": "mingw"
      }
    },
    {
      "name": "clang-22-asan",
      "displayName": "Clang 22 + libc++ with ASan and UBSan",
      "inherits": "clang-22",
      "cacheVariables": {
        "CPPDOCS_SANITIZE": "address,undefined"
      }
    },
    {
      "name": "gcc-16-asan",
      "displayName": "GCC 16 (gcc:16 Docker image) with ASan and UBSan",
      "inherits": "gcc-16",
      "cacheVariables": {
        "CPPDOCS_SANITIZE": "address,undefined"
      }
    },
    {
      "name": "gcc-15-hardened",
      "displayName": "GCC 15 (Homebrew g++-15) hardened (library hardening, stack protection, PIE; RelWithDebInfo)",
      "inherits": "gcc-15",
      "cacheVariables": {
        "CPPDOCS_HARDEN": "ON",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "clang-22-hardened",
      "displayName": "Clang 22 + libc++ hardened (libc++ fast mode, stack protection, PIE; RelWithDebInfo)",
      "inherits": "clang-22",
      "cacheVariables": {
        "CPPDOCS_HARDEN": "ON",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "gcc-16-hardened",
      "displayName": "GCC 16 (gcc:16 Docker image) hardened (assertions, _FORTIFY_SOURCE=3, RELRO, PIE; RelWithDebInfo)",
      "inherits": "gcc-16",
      "cacheVariables": {
        "CPPDOCS_HARDEN": "ON",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "gcc-15",
      "configurePreset": "gcc-15"
    },
    {
      "name": "clang-22",
      "configurePreset": "clang-22"
    },
    {
      "name": "gcc-16",
      "configurePreset": "gcc-16"
    },
    {
      "name": "gcc",
      "configurePreset": "gcc"
    },
    {
      "name": "clang",
      "configurePreset": "clang"
    },
    {
      "name": "clang-libcxx",
      "configurePreset": "clang-libcxx"
    },
    {
      "name": "msvc",
      "configurePreset": "msvc",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "clang-cl",
      "configurePreset": "clang-cl",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "mingw",
      "configurePreset": "mingw"
    },
    {
      "name": "clang-22-asan",
      "configurePreset": "clang-22-asan"
    },
    {
      "name": "gcc-16-asan",
      "configurePreset": "gcc-16-asan"
    },
    {
      "name": "gcc-15-hardened",
      "configurePreset": "gcc-15-hardened"
    },
    {
      "name": "clang-22-hardened",
      "configurePreset": "clang-22-hardened"
    },
    {
      "name": "gcc-16-hardened",
      "configurePreset": "gcc-16-hardened"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "jobs": 8
      }
    },
    {
      "name": "gcc-15",
      "inherits": "base",
      "configurePreset": "gcc-15"
    },
    {
      "name": "clang-22",
      "inherits": "base",
      "configurePreset": "clang-22"
    },
    {
      "name": "gcc-16",
      "inherits": "base",
      "configurePreset": "gcc-16"
    },
    {
      "name": "gcc",
      "inherits": "base",
      "configurePreset": "gcc"
    },
    {
      "name": "clang",
      "inherits": "base",
      "configurePreset": "clang"
    },
    {
      "name": "clang-libcxx",
      "inherits": "base",
      "configurePreset": "clang-libcxx"
    },
    {
      "name": "msvc",
      "inherits": "base",
      "configurePreset": "msvc",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "clang-cl",
      "inherits": "base",
      "configurePreset": "clang-cl",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "mingw",
      "inherits": "base",
      "configurePreset": "mingw"
    },
    {
      "name": "clang-22-asan",
      "configurePreset": "clang-22-asan",
      "inherits": "base",
      "environment": {
        "ASAN_OPTIONS": "halt_on_error=1:abort_on_error=0:allocator_may_return_null=1:detect_stack_use_after_return=1:strict_string_checks=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1",
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1"
      }
    },
    {
      "name": "gcc-16-asan",
      "configurePreset": "gcc-16-asan",
      "inherits": "base",
      "environment": {
        "ASAN_OPTIONS": "halt_on_error=1:abort_on_error=0:allocator_may_return_null=1:detect_stack_use_after_return=1:strict_string_checks=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1",
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1"
      }
    },
    {
      "name": "gcc-15-hardened",
      "configurePreset": "gcc-15-hardened",
      "inherits": "base"
    },
    {
      "name": "clang-22-hardened",
      "configurePreset": "clang-22-hardened",
      "inherits": "base"
    },
    {
      "name": "gcc-16-hardened",
      "configurePreset": "gcc-16-hardened",
      "inherits": "base"
    }
  ],
